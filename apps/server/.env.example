# Server port
PORT=3003

# Database
DATABASE_URL="postgresql://user:password@host:5432/accessories_world"

# App URLs (for CORS)
WEB_URL=https://accessoriesworld.co.zw
ADMIN_URL=https://admin.accessoriesworld.co.zw
WHOLESALER_URL=https://wholesale.accessoriesworld.co.zw

# Agent Service
AGENT_URL=http://localhost:3004

# WhatsApp / Business
BUSINESS_WHATSAPP=+263784923973

# Follow-up message delay (optional, defaults to 72 hours = 259200000 ms)
# Set to a small value for local testing, e.g. 10000 (10 seconds)
# FOLLOW_UP_DELAY_MS=10000

# Cloudflare R2 / S3 Storage
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET=accessories-world
NEXT_PUBLIC_R2_PUBLIC_URL=https://your-account.r2.cloudflarestorage.com/your-bucket

# Google Merchant Center Sync
MERCHANT_SYNC_ENABLED=true
MERCHANT_SYNC_BLOCKING=true
MERCHANT_CENTER_ACCOUNT_ID=5779850131
MERCHANT_DATASOURCE_ID=10647438347
MERCHANT_CONTENT_LANGUAGE=en
MERCHANT_FEED_LABEL=ZW
MERCHANT_CURRENCY=USD
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@project-id.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"